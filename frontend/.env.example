# Monad Testnet RPC endpoint (public, safe to expose client-side)
NEXT_PUBLIC_MONAD_RPC=https://testnet-rpc.monad.xyz

# Deployed contract addresses (public, safe to expose client-side)
NEXT_PUBLIC_AGENT_WALLET_ADDRESS=0x7263058B4040ae7410340f63d292152DE8d867FA
NEXT_PUBLIC_ESCROW_ADDRESS=0x0AEb04B6e92984EC94BbbB4aF234efD080e8e9f1

# Canonical demo task (public data, matches the proven Monad Testnet E2E run)
NEXT_PUBLIC_DEMO_TASK_ID=0x2de071b37262e1f5721ed785c2445e9d1b13a7ce96b2a4ce13d111bb4b2587aa
NEXT_PUBLIC_DEMO_ESCROW_TX=0x6ae4d56c17415e404189ad50c6c511ee1b09afd21c5e891409e1b9b7565b4e3e
NEXT_PUBLIC_DEMO_PROVIDER_TX=0x198deaaea2270dc7ac09c0c82cffc4e4d61dab9d0dd5b3edcb312994e0c89d93
NEXT_PUBLIC_DEMO_SETTLEMENT_TX=0x59f5387dc0af2098347ba3155729f37ad9d3591ac316218424ce33eb22e273b0

# AgentProof FastAPI backend (public origin; no secrets)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Provider payout EOA (public address; separate from agent and verifier)
NEXT_PUBLIC_PROVIDER_ADDRESS=0x322BE7De3f74e57B87F24Bb68199e89d97652697

# Never put private keys here. NEXT_PUBLIC_* variables are shipped to the browser.
