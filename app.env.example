# ============================================================
# FastAPI + LangGraph orchestration layer
# Copy to .env or set these in your host's environment.
# This layer holds NO economic private key.
# ============================================================

# development | production. Outside development the app refuses a default JWT_SECRET,
# a wildcard CORS origin, and ALLOW_LOCAL_PROVIDER=true, and forces debug off.
ENVIRONMENT=development

# Canonical agent service (the only process that signs)
AGENT_SERVICE_URL=http://localhost:4100
AGENT_SERVICE_TIMEOUT=30.0
AGENT_SERVICE_MAX_WAIT=180.0

# MUST remain false for any real demo. True is for the hermetic test suite only.
USE_MOCK_PAYMENTS=false

# Explicit CORS allowlist. Never "*" in production.
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Permits the localhost provider endpoint past SSRF checks. MUST be false in production.
ALLOW_LOCAL_PROVIDER=true

# Echoes stack traces to clients. Must stay false in production (also force-disabled there).
DEBUG=false

# SECRET: generate with `openssl rand -hex 32`. Required outside development.
JWT_SECRET=

# Chain / contract configuration (public values)
CHAIN_ID=10143
MONAD_RPC=https://testnet-rpc.monad.xyz
AGENT_WALLET_ADDRESS=0x7263058B4040ae7410340f63d292152DE8d867FA
ESCROW_ADDRESS=0x0AEb04B6e92984EC94BbbB4aF234efD080e8e9f1

# Canonical demo economics. The task cap must never exceed WALLET_MAX_PAYMENT_MON.
TASK_REWARD_MON=0.05
TASK_SPENDING_LIMIT_MON=0.02
WALLET_MAX_PAYMENT_MON=0.02
