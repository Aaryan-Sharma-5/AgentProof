# Monad Testnet RPC endpoint
MONAD_RPC=

# Deployer key, used only for `forge create` (see contracts/, not this workspace)
DEPLOYER_KEY=

# Trusted evaluator private key. Signs result digests. Never expose client-side.
VERIFIER_KEY=

# Agent/worker private key. Same identity spends through AgentWallet and receives payouts from AgentEscrow.
AGENT_KEY=

# Deployed contract addresses
AGENT_WALLET_ADDRESS=
ESCROW_ADDRESS=

# Provider mock server
PROVIDER_PORT=4000
PROVIDER_ADDRESS=
PROVIDER_INVOICE_MON=0.01
PROVIDER_URL=http://localhost:4000/pricing

# Canonical demo economics
TASK_REWARD_MON=0.05
TASK_SPENDING_LIMIT_MON=0.02
