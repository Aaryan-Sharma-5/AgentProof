# ============================================================
# agents/.env - SECRETS LIVE HERE AND NOWHERE ELSE
# This file is gitignored. Never commit a filled-in copy.
# ============================================================

# Monad Testnet RPC endpoint
MONAD_RPC=https://testnet-rpc.monad.xyz

# --- SECRETS ---
# Deployer key, used only for contracts/script/Deploy.s.sol. Not needed to run the demo.
DEPLOYER_KEY=

# Trusted evaluator private key. Signs result digests.
# Must correspond to AgentEscrow.trustedVerifier(). Never expose client-side.
VERIFIER_KEY=

# Agent/worker private key. Spends through AgentWallet and receives AgentEscrow payouts.
# Must correspond to AgentWallet.agent().
AGENT_KEY=

# --- PUBLIC ADDRESSES (already deployed on Monad Testnet, chain 10143) ---
AGENT_WALLET_ADDRESS=0x7263058B4040ae7410340f63d292152DE8d867FA
ESCROW_ADDRESS=0x0AEb04B6e92984EC94BbbB4aF234efD080e8e9f1

# --- PROVIDER ---
# A SEPARATE EOA from the agent and verifier, so the 0.01 MON service payment is a genuine
# external transfer. The provider only reads PaymentSettled events, so its private key is
# NOT required at runtime and must never be stored in this repo.
PROVIDER_ADDRESS=0x322BE7De3f74e57B87F24Bb68199e89d97652697
PROVIDER_PORT=4000
PROVIDER_INVOICE_MON=0.01
PROVIDER_URL=http://localhost:4000/pricing

# --- CANONICAL AGENT SERVICE (the sole economic signer process) ---
AGENT_SERVICE_PORT=4100

# --- CANONICAL DEMO ECONOMICS ---
TASK_REWARD_MON=0.05
TASK_SPENDING_LIMIT_MON=0.02
